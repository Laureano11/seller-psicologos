# Base de datos (en docker compose se sobreescribe con el host `db`)
DATABASE_URL=postgres://seller:seller@localhost:5432/seller

# Zona horaria y ritmo (máx. 5 contactos nuevos por día, ventanas de envío y reuniones)
TZ=America/Argentina/Buenos_Aires
DAILY_NEW_CONTACTS=5
SEND_WINDOW=mon-fri 09:00-20:00
MEETING_WINDOW=mon-fri 10:00-18:00
MEETING_MINUTES=30
SEARCH_HOUR=9
BUSCADOR_MAX_PER_DAY=50
# Buscador con navegador: topes por corrida y pausas aleatorias (segundos "min-max")
BUSCADOR_MAX_SEARCHES=25
BUSCADOR_MAX_PAGES=150
BUSCADOR_RESULTS_PER_QUERY=10
BUSCADOR_MAX_WA_CHECKS=150
BUSCADOR_SEARCH_DELAY=20-60
BUSCADOR_PAGE_DELAY=3-8
# Motor principal: google o duckduckgo (el otro queda de respaldo si hay CAPTCHA)
BUSCADOR_ENGINE=google
FOLLOWUP_DAYS=3
CLOSE_AFTER_DAYS=4
MAX_FOLLOWUPS=1
AB_MIN_PER_VARIANT=30
REPLY_DEBOUNCE_SECONDS=30

# Dueño (Lauri): número de WhatsApp en formato internacional sin +
# OBLIGATORIO: tu número real (10 a 15 dígitos, ej. 5491123456789); sin esto no arranca
OWNER_WA_ID=
OWNER_NAME=Lauri

# Registro No Llame: file (exige DNC_FILE) | off (el hub muestra advertencia permanente)
DNC_MODE=file
# Dentro del contenedor: poné el listado en ./data/no_llame.csv (se monta en /app/data)
DNC_FILE=/app/data/no_llame.csv

# LLM por agente (Gemini y Groq tienen plan gratuito; para modelos pagos editá estas líneas)
# lista "proveedor:modelo" separada por comas (orden = fallback)
LLM_BUSCADOR=google:gemini-2.5-flash-lite,groq:llama-3.1-8b-instant
LLM_VENDEDOR=google:gemini-2.5-flash,groq:llama-3.3-70b-versatile
LLM_ANALISTA=google:gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Dentro de Docker, localhost no llega al host: usá http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=

# Google: Places para el buscador; OAuth (Calendar + Gmail) para agendar reuniones
# GOOGLE_REFRESH_TOKEN se obtiene con `npm run google:auth`
GOOGLE_PLACES_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Hub web: vacía = sin contraseña (solo uso local, el puerto escucha en 127.0.0.1).
# Antes de publicarlo en internet (túnel) poné una contraseña fuerte, mínimo 10 caracteres.
HUB_USER=admin
HUB_PASSWORD=

# Contenido (manuales .md) y sesión de WhatsApp
CONTENT_DIR=content
WA_AUTH_DIR=wa_auth

# Solo para `docker compose --profile tunnel up -d` (Cloudflare Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
