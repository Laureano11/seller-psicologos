# Base de datos (en docker compose se sobreescribe con el host `db`)
DATABASE_URL=postgres://seller:seller@localhost:5432/seller

# Zona horaria y ritmo (máx. 5 contactos nuevos por día, ventanas de envío y reuniones)
TZ=America/Argentina/Buenos_Aires
DAILY_NEW_CONTACTS=5
SEND_WINDOW=mon-fri 09:00-20:00
MEETING_WINDOW=mon-fri 10:00-18:00
MEETING_MINUTES=30
SEARCH_HOUR=9
BUSCADOR_MAX_PER_DAY=50
FOLLOWUP_DAYS=3
CLOSE_AFTER_DAYS=4
MAX_FOLLOWUPS=1
AB_MIN_PER_VARIANT=30
REPLY_DEBOUNCE_SECONDS=30

# Dueño (Lauri) -- IMPORTANTE: poné tu número real antes de iniciar el worker: numero de WhatsApp en formato internacional sin +
OWNER_WA_ID=5491100000000
OWNER_NAME=Lauri

# Registro No Llame: file (exige DNC_FILE) | off (el hub muestra advertencia permanente)
DNC_MODE=file
DNC_FILE=./no_llame.csv

# LLM por agente (Gemini y Groq tienen plan gratuito; para modelos pagos editá estas líneas)
# lista "proveedor:modelo" separada por comas (orden = fallback)
LLM_BUSCADOR=google:gemini-2.5-flash-lite,groq:llama-3.1-8b-instant
LLM_VENDEDOR=google:gemini-2.5-flash,groq:llama-3.3-70b-versatile
LLM_ANALISTA=google:gemini-2.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# Google: Places para el buscador; OAuth (Calendar + Gmail) para agendar reuniones
# GOOGLE_REFRESH_TOKEN se obtiene con `npm run google:auth`
GOOGLE_PLACES_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Hub web (acceso con usuario y contraseña) -- usá una contraseña fuerte
HUB_USER=admin
HUB_PASSWORD=cambiame

# Contenido (manuales .md) y sesión de WhatsApp
CONTENT_DIR=content
WA_AUTH_DIR=wa_auth

# Solo para `docker compose --profile tunnel up -d` (Cloudflare Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
